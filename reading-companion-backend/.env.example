# Shared LLM registry
# Current local setup: CPA Manager Plus exposes a loopback OpenAI-compatible target.
LLM_TARGETS_PATH=./config/llm_targets.local.json
LLM_PROFILE_BINDINGS_PATH=./config/llm_profile_bindings.local.json
CPA_PROXY_API_KEY=your-local-cpa-api-key-here

# Tavily Search API
TAVILY_API_KEY=your-tavily-api-key-here

# Product defaults
UPLOAD_MAX_BYTES=104857600

# Local API server
BACKEND_RUNTIME_ROOT=.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Optional runtime observability exporter settings. Disabled by default.
# Install the client dependencies with: pip install -e ".[observability]"
READING_OBSERVABILITY_OTLP_ENABLED=0
READING_OBSERVABILITY_OTLP_ENDPOINT=http://127.0.0.1:6006/v1/traces
READING_OBSERVABILITY_PROJECT=reading-companion-runtime
OTEL_SERVICE_NAME=reading-companion-backend

# Privacy-first OpenInference defaults for book text and model payloads.
OPENINFERENCE_HIDE_INPUTS=true
OPENINFERENCE_HIDE_OUTPUTS=true
OPENINFERENCE_HIDE_LLM_INVOCATION_PARAMETERS=true
OPENINFERENCE_HIDE_LLM_TOOLS=true
OPENINFERENCE_HIDE_EMBEDDING_VECTORS=true
