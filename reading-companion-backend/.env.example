# Shared LLM registry
# Current local setup: explicit OpenCode Go targets and profile bindings.
LLM_TARGETS_PATH=./config/llm_targets.local.json
LLM_PROFILE_BINDINGS_PATH=./config/llm_profile_bindings.local.json
OPENCODE_GO_API_KEY=your-opencode-go-api-key-here

# Tavily Search API
TAVILY_API_KEY=your-tavily-api-key-here

# Product defaults
UPLOAD_MAX_BYTES=104857600

# Local API server
BACKEND_RUNTIME_ROOT=.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
