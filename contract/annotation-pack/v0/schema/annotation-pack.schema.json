{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://captain4whale.github.io/second-reader/schema/annotation-pack/v0/annotation-pack.schema.json",
  "title": "Second Reader Annotation Pack v0",
  "description": "Second Reader's minimal W3C Web Annotation and Dublin Core aligned AnnotationSet profile. This is a project schema, not a W3C schema or a claim of full EPUB Annotations conformance.",
  "type": "object",
  "required": [
    "@context",
    "id",
    "type",
    "generator",
    "generated",
    "about",
    "items"
  ],
  "properties": {
    "@context": {
      "const": "https://www.w3.org/ns/epub-anno.jsonld"
    },
    "id": {
      "$ref": "#/$defs/uuidV5Urn"
    },
    "type": {
      "const": "AnnotationSet"
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "generated": {
      "$ref": "#/$defs/utcDateTime"
    },
    "about": {
      "$ref": "#/$defs/publication"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/annotation"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "uuidV5Urn": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utcDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "relativeEpubHref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[?#\\\\])[^\\s]+$"
    },
    "generator": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name"
      ],
      "properties": {
        "id": {
          "const": "https://github.com/Captain4Whale/second-reader"
        },
        "type": {
          "const": "Software"
        },
        "name": {
          "const": "Second Reader Annotation Pack Exporter"
        }
      },
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "required": [
        "dc:identifier",
        "dc:format",
        "dc:title"
      ],
      "properties": {
        "dc:identifier": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "pattern": "^nih:sha-256;[0-9a-f]{64}$"
            }
          ],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "dc:format": {
          "const": "application/epub+zip"
        },
        "dc:title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "dc:creator": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "annotation": {
      "type": "object",
      "required": [
        "id",
        "type",
        "motivation",
        "created",
        "target"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuidV5Urn"
        },
        "type": {
          "const": "Annotation"
        },
        "motivation": {
          "enum": [
            "highlighting",
            "commenting"
          ]
        },
        "created": {
          "$ref": "#/$defs/utcDateTime"
        },
        "body": {
          "$ref": "#/$defs/textualBody"
        },
        "target": {
          "$ref": "#/$defs/annotationTarget"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "motivation": {
                "const": "highlighting"
              }
            },
            "required": [
              "motivation"
            ]
          },
          "then": {
            "not": {
              "required": [
                "body"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "motivation": {
                "const": "commenting"
              }
            },
            "required": [
              "motivation"
            ]
          },
          "then": {
            "required": [
              "body"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "textualBody": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "TextualBody"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "additionalProperties": false
    },
    "annotationTarget": {
      "type": "object",
      "required": [
        "source",
        "selector"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/relativeEpubHref"
        },
        "selector": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/textQuoteSelector"
            },
            {
              "$ref": "#/$defs/textPositionSelector"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "textQuoteSelector": {
      "type": "object",
      "required": [
        "type",
        "exact"
      ],
      "properties": {
        "type": {
          "const": "TextQuoteSelector"
        },
        "exact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "prefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "suffix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "textPositionSelector": {
      "type": "object",
      "required": [
        "type",
        "start",
        "end"
      ],
      "properties": {
        "type": {
          "const": "TextPositionSelector"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
